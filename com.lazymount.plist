<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Installer supplies absolute ProgramArguments, HOME and Python path. -->
    <key>Label</key><string>com.lazymount</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <!-- Allow an active offline repair to finish on normal service shutdown. -->
    <key>ExitTimeOut</key><integer>0</integer>
</dict>
</plist>
